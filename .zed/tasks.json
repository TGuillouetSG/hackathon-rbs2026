[
  {
    "label": "Run Flask app",
    "command": "uv",
    "args": [
      "run",
      "--project",
      "$ZED_WORKTREE_ROOT/starter",
      "flask",
      "--app",
      "server.app",
      "run",
      "--no-debugger",
      "--no-reload"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/starter",
    "env": {
      "FLASK_DEBUG": "1"
    },
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]

[
  {
    "label": "Run Flask app",
    "command": "uv",
    "args": [
      "run",
      "--project",
      "$ZED_WORKTREE_ROOT/starter",
      "python",
      "-m",
      "flask",
      "run",
      "--no-debugger",
      "--no-reload"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/starter/server",
    "env": {
      "FLASK_APP": "app.py",
      "FLASK_ENV": "development",
      "FLASK_DEBUG": "1"
    },
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]

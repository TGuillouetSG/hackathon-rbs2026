{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py", // Replace with your main Flask file
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger", // Optional: Prevent conflicts with Werkzeug debugger
                "--no-reload" // Optional: Disable auto-reload for debugging
            ],
            "cwd": "${workspaceFolder}/starter/server",
            "jinja": true,
            "justMyCode": true
        }
    ]
}